<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark theme overrides for EDDI design system -->

  <!-- Background Brushes -->
  <SolidColorBrush x:Key="BrushBackgroundPrimary" Color="#151420"/>
  <SolidColorBrush x:Key="BrushBackgroundSecondary" Color="#1F1C35"/>
  <SolidColorBrush x:Key="BrushBackgroundTertiary" Color="#292548"/>

  <!-- Surface Brushes -->
  <SolidColorBrush x:Key="BrushSurfaceBase" Color="#1C1A2F"/>
  <SolidColorBrush x:Key="BrushSurfaceSecondary" Color="#232045"/>
  <SolidColorBrush x:Key="BrushSurfaceVariant" Color="#2F2B55"/>

  <!-- Text Brushes -->
  <SolidColorBrush x:Key="BrushTextPrimary" Color="#F2F1FF"/>
  <SolidColorBrush x:Key="BrushTextSecondary" Color="#C6C0EA"/>
  <SolidColorBrush x:Key="BrushTextTertiary" Color="#918DC6"/>
  <SolidColorBrush x:Key="BrushTextDisabled" Color="#6B6684"/>

  <!-- Brand / Accent -->
  <SolidColorBrush x:Key="BrushPrimaryBrand" Color="#8B82FF"/>
  <SolidColorBrush x:Key="BrushAccent" Color="#B7AEFF"/>
  <SolidColorBrush x:Key="BrushTertiaryBrand" Color="#4CAF50"/>
  <SolidColorBrush x:Key="BrushDangerBrand" Color="#E74C3C"/>
  <SolidColorBrush x:Key="BrushWarningBrand" Color="#FFB900"/>

  <!-- Borders & DataGrid -->
  <SolidColorBrush x:Key="BrushBorderLight" Color="#3A3458"/>
  <SolidColorBrush x:Key="BrushBorderMedium" Color="#554F84"/>
  <SolidColorBrush x:Key="BrushBorderDark" Color="#6E65A1"/>
  <SolidColorBrush x:Key="BrushDataGridAlternatingRow" Color="#23203F"/>
  <SolidColorBrush x:Key="BrushDataGridLine" Color="#3A3458"/>

</ResourceDictionary>
