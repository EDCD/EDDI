<Window x:Class="EddiUI.WebVoiceProvidersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="760"
        Height="480"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10" LastChildFill="True" Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="saveButton" Width="90" Margin="0,0,5,0" Click="saveButton_Click" />
            <Button x:Name="cancelButton" Width="90" Click="cancelButton_Click" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,10,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <ComboBox x:Name="newProviderTypeDropDown" Margin="0,0,0,6" DisplayMemberPath="DisplayName" SelectedValuePath="ProviderType" SelectionChanged="newProviderTypeDropDown_SelectionChanged" />
                    <Button x:Name="addProfileButton" Click="addProfileButton_Click" />
                </StackPanel>
                <ListBox x:Name="providerProfilesList" SelectionChanged="providerProfilesList_SelectionChanged" />
            </DockPanel>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label x:Name="providerTypeLabel" Grid.Row="0" Grid.Column="0" Margin="0,0,8,6" VerticalContentAlignment="Center" />
                <ComboBox x:Name="providerTypeDropDown" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="DisplayName" SelectedValuePath="ProviderType" SelectionChanged="providerTypeDropDown_SelectionChanged" />
                <TextBlock x:Name="providerInfoLinksTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap" />
                <Label x:Name="profileNameLabel" Grid.Row="2" Grid.Column="0" Margin="0,0,8,6" VerticalContentAlignment="Center" />
                <TextBox x:Name="profileNameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" TextChanged="profileField_Changed" />
                <Label x:Name="profileEnabledLabel" Grid.Row="3" Grid.Column="0" Margin="0,0,8,6" VerticalContentAlignment="Center" />
                <CheckBox x:Name="profileEnabledCheckBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" VerticalAlignment="Center" Checked="profileField_Changed" Unchecked="profileField_Changed" />
                <Label x:Name="profileSettingsLabel" Grid.Row="4" Grid.Column="0" Margin="0,0,8,6" VerticalContentAlignment="Center" />
                <StackPanel x:Name="profileSettingsPanel" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" />
                <Label x:Name="profileLocaleFiltersLabel" Grid.Row="5" Grid.Column="0" Margin="0,0,8,6" VerticalContentAlignment="Center" />
                <TextBox x:Name="profileLocaleFiltersTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,2" TextChanged="profileField_Changed" />
                <TextBlock x:Name="profileLocaleFiltersHelpTextBlock" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap" />
                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="verifyProfileButton" Width="90" Margin="0,0,5,0" Click="verifyProfileButton_Click" />
                    <Button x:Name="clearCredentialsButton" Width="125" Margin="0,0,5,0" Click="clearCredentialsButton_Click" />
                    <Button x:Name="removeProfileButton" Width="90" Click="removeProfileButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
