<UserControl x:Class="EddiNavigationMonitor.ConfigurationWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EddiNavigationMonitor"
             xmlns:resx="clr-namespace:EddiNavigationMonitor.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackgroundBrush}">
        <TabControl x:Name="tabControl" DockPanel.Dock="Top" TabStripPlacement="Top">
            <TabItem Header ="{x:Static resx:NavigationMonitor.tab_bookmarks}" Padding="25, 0">
                <local:BookmarksControl/>
            </TabItem>
            <TabItem Header ="{x:Static resx:NavigationMonitor.tab_galactic_poi}" Padding="25, 0">
                <local:GalacticPOIControl/>
            </TabItem>
            <TabItem Header ="{x:Static resx:NavigationMonitor.tab_plotted_route}" Padding="25, 0">
                <local:CurrentRouteControl/>
            </TabItem>
            <TabItem Header ="{x:Static resx:NavigationMonitor.tab_plot_carrier_route}" Padding="25, 0">
                <local:PlotCarrierControl/>
            </TabItem>
            <TabItem Header ="{x:Static resx:NavigationMonitor.tab_plot_ship_route}" Padding="25, 0">
                <local:PlotShipControl/>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
