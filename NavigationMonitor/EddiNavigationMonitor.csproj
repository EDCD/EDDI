<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <UseWPF>true</UseWPF>
        <!--Dynamic loading copies dependencies of dynamically loaded assemblies to the output directory-->
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
        <OutputPath>..\bin\Debug\</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
        <OutputPath>..\bin\Release\</OutputPath>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ConfigService\EddiConfigService.csproj" />
        <ProjectReference Include="..\DataDefinitions\EddiDataDefinitions.csproj" />
        <ProjectReference Include="..\DataProviderService\EddiDataProviderService.csproj" />
        <ProjectReference Include="..\EddiCore\EddiCore.csproj" />
        <ProjectReference Include="..\Events\EddiEvents.csproj" />
        <ProjectReference Include="..\NavigationService\EddiNavigationService.csproj" />
        <ProjectReference Include="..\Utilities\Utilities.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CommonMark.NET" />
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Microsoft.CSharp" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="System.Runtime" />
        <PackageReference Include="System.Runtime.Extensions" />
    </ItemGroup>
    <ItemGroup>
        <Resource Include="Images\Copy.png" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Properties\NavigationMonitor.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>NavigationMonitor.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Properties\NavigationMonitor.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>NavigationMonitor.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
</Project>
