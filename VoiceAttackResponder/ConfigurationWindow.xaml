<UserControl x:Class="EddiVoiceAttackResponder.ConfigurationWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EddiVoiceAttackResponder"
             xmlns:resx="clr-namespace:EddiVoiceAttackResponder.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackgroundBrush}">
        <RichTextBox DockPanel.Dock="Top" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0">
            <FlowDocument>
                <Paragraph>
                    <Run Text="{x:Static resx:VoiceAttack.p1}" />
                </Paragraph>
                <Paragraph>
                    <Run Text="{x:Static resx:VoiceAttack.p2}" />
                </Paragraph>
                <Paragraph>
                    <Run Text="{x:Static resx:VoiceAttack.p3}" />
                </Paragraph>
                <Paragraph>
                    <Run Text="{x:Static resx:VoiceAttack.p4}" />
                    <Hyperlink Click="VAVariablesClicked">
                        <Run Text="{x:Static resx:VoiceAttack.p4_link}" />
                    </Hyperlink>.
                </Paragraph>
                <Paragraph>
                    <Run Text="{x:Static resx:VoiceAttack.p5}" />
                    <Hyperlink Click="VAEventsClicked">
                        <Run Text="{x:Static resx:VoiceAttack.p5_link}" />
                    </Hyperlink>.
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
    </DockPanel>
</UserControl>
